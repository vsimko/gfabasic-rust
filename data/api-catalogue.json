{"schema_version":2,"generated_from":"api/registry/**/*.toml","counts":{"total":29,"by_namespace":{"amiga":4,"atari-st":1,"language-core":24},"by_evidence_status":{"book-documented":28,"disputed":1},"by_implementation_status":{"not-implemented":26,"partial":3},"by_target_support":{"x86_64-unknown-linux-gnu":{"unknown":28,"unsupported":1}},"by_target_conformance":{"x86_64-unknown-linux-gnu":{"not-tested":29}}},"entries":[{"id":"gfa.amiga.system.guru-check","name":"GURU","kind":"statement","namespace":"amiga","category":"special-and-platform-commands","detail":"api-catalogue-details/gfa.amiga.system.guru-check.json","syntax":["GURU numeric-expression"],"summary":"Disables GURU checking when the argument is 0 and enables it when the argument is nonzero. On a GURU Meditation, control transfers to ONERROR GOSUB or error #109 is generated.","evidence_status":"book-documented","implementation_status":"not-implemented","support":[{"target":"x86_64-unknown-linux-gnu","classification":"unknown","conformance":"not-tested"}]},{"id":"gfa.amiga.system.guru-number","name":"GURU","kind":"function","namespace":"amiga","category":"special-and-platform-commands","detail":"api-catalogue-details/gfa.amiga.system.guru-number.json","syntax":["GURU"],"summary":"Returns the GURU number associated with the current GURU condition.","evidence_status":"book-documented","implementation_status":"not-implemented","support":[{"target":"x86_64-unknown-linux-gnu","classification":"unknown","conformance":"not-tested"}]},{"id":"gfa.amiga.windows.openw-negative-screen","name":"OPENW","kind":"statement","namespace":"amiga","category":"special-and-platform-commands","detail":"api-catalogue-details/gfa.amiga.windows.openw-negative-screen.json","syntax":["OPENW with a negative screen number"],"summary":"When the screen number is negative, opens the window on the current (top) screen.","evidence_status":"book-documented","implementation_status":"not-implemented","support":[{"target":"x86_64-unknown-linux-gnu","classification":"unknown","conformance":"not-tested"}]},{"id":"gfa.amiga.graphics.pcolor","name":"PCOLOR","kind":"statement","namespace":"amiga","category":"special-and-platform-commands","detail":"api-catalogue-details/gfa.amiga.graphics.pcolor.json","syntax":["PCOLOR foreground[, background]"],"summary":"Sets the foreground and optional background colours for screen output subsequently produced by PRINT; the command is described as otherwise behaving like COLOR.","evidence_status":"book-documented","implementation_status":"not-implemented","support":[{"target":"x86_64-unknown-linux-gnu","classification":"unknown","conformance":"not-tested"}]},{"id":"gfa.atari-st.system.timer","name":"TIMER","kind":"variable","namespace":"atari-st","category":"time","detail":"api-catalogue-details/gfa.atari-st.system.timer.json","syntax":["variable-reference"],"summary":"Reserved counter of elapsed 1/200-second ticks since system start.","evidence_status":"book-documented","implementation_status":"not-implemented","support":[{"target":"x86_64-unknown-linux-gnu","classification":"unsupported","conformance":"not-tested"}]},{"id":"gfa.language.math.combin","name":"COMBIN","kind":"function","namespace":"language-core","category":"math-and-matrix","detail":"api-catalogue-details/gfa.language.math.combin.json","syntax":["COMBIN(integer-expression, integer-expression)"],"summary":"Returns the number of k-combinations of n elements without repetition: n!/((n-k)!*k!).","evidence_status":"book-documented","implementation_status":"partial","support":[{"target":"x86_64-unknown-linux-gnu","classification":"unknown","conformance":"not-tested"}]},{"id":"gfa.language.math.fact","name":"FACT","kind":"function","namespace":"language-core","category":"math-and-matrix","detail":"api-catalogue-details/gfa.language.math.fact.json","syntax":["FACT(integer-expression)"],"summary":"Returns the factorial n!; the addendum explicitly defines 0! as 1.","evidence_status":"book-documented","implementation_status":"partial","support":[{"target":"x86_64-unknown-linux-gnu","classification":"unknown","conformance":"not-tested"}]},{"id":"gfa.language.matrix.mat-base","name":"MAT BASE","kind":"statement","namespace":"language-core","category":"math-and-matrix","detail":"api-catalogue-details/gfa.language.matrix.mat-base.json","syntax":["MAT BASE 0 | MAT BASE 1"],"summary":"Sets the row/column index offset used by the documented matrix operations; the default is 1.","evidence_status":"book-documented","implementation_status":"not-implemented","support":[{"target":"x86_64-unknown-linux-gnu","classification":"unknown","conformance":"not-tested"}]},{"id":"gfa.language.matrix.mat-clr","name":"MAT CLR","kind":"statement","namespace":"language-core","category":"math-and-matrix","detail":"api-catalogue-details/gfa.language.matrix.mat-clr.json","syntax":["MAT CLR array()"],"summary":"Sets every element of the specified vector or matrix to zero.","evidence_status":"book-documented","implementation_status":"not-implemented","support":[{"target":"x86_64-unknown-linux-gnu","classification":"unknown","conformance":"not-tested"}]},{"id":"gfa.language.matrix.mat-norm","name":"MAT NORM","kind":"statement","namespace":"language-core","category":"math-and-matrix","detail":"api-catalogue-details/gfa.language.matrix.mat-norm.json","syntax":["MAT NORM array(), 0 | 1"],"summary":"Normalizes each row when mode is 0, or each column when mode is 1, so the sum of squares of the elements in each normalized vector is 1.","evidence_status":"book-documented","implementation_status":"not-implemented","support":[{"target":"x86_64-unknown-linux-gnu","classification":"unknown","conformance":"not-tested"}]},{"id":"gfa.language.matrix.mat-one","name":"MAT ONE","kind":"statement","namespace":"language-core","category":"math-and-matrix","detail":"api-catalogue-details/gfa.language.matrix.mat-one.json","syntax":["MAT ONE array()"],"summary":"Generates a square identity matrix: diagonal elements are 1 and all other elements are 0.","evidence_status":"book-documented","implementation_status":"not-implemented","support":[{"target":"x86_64-unknown-linux-gnu","classification":"unknown","conformance":"not-tested"}]},{"id":"gfa.language.matrix.mat-set","name":"MAT SET","kind":"statement","namespace":"language-core","category":"math-and-matrix","detail":"api-catalogue-details/gfa.language.matrix.mat-set.json","syntax":["MAT SET array()=scalar"],"summary":"Sets every element of the specified vector or matrix to the supplied scalar.","evidence_status":"book-documented","implementation_status":"not-implemented","support":[{"target":"x86_64-unknown-linux-gnu","classification":"unknown","conformance":"not-tested"}]},{"id":"gfa.language.matrix.mat-trans","name":"MAT TRANS","kind":"statement","namespace":"language-core","category":"math-and-matrix","detail":"api-catalogue-details/gfa.language.matrix.mat-trans.json","syntax":["MAT TRANS destination() [= source()]"],"summary":"Transposes a square matrix in place when the source is omitted, or copies the transpose of source into destination.","evidence_status":"book-documented","implementation_status":"not-implemented","support":[{"target":"x86_64-unknown-linux-gnu","classification":"unknown","conformance":"not-tested"}]},{"id":"gfa.language.math.variat","name":"VARIAT","kind":"function","namespace":"language-core","category":"math-and-matrix","detail":"api-catalogue-details/gfa.language.math.variat.json","syntax":["VARIAT(integer-expression, integer-expression)"],"summary":"Returns the number of k-permutations of n elements without repetition: n!/(n-k)!.","evidence_status":"book-documented","implementation_status":"partial","support":[{"target":"x86_64-unknown-linux-gnu","classification":"unknown","conformance":"not-tested"}]},{"id":"gfa.language.matrix.mat-add","name":"MAT ADD","kind":"statement","namespace":"language-core","category":"matrix-operations","detail":"api-catalogue-details/gfa.language.matrix.mat-add.json","syntax":["MAT ADD destination()=left()+right()","MAT ADD destination(),source()","MAT ADD destination(),scalar"],"summary":"Adds matrices/vectors element by element, or adds a scalar to every element. The three-field form writes the result to a destination; the two-argument forms mutate the destination in place. Array operands in the element-wise forms must have the same order.","evidence_status":"book-documented","implementation_status":"not-implemented","support":[{"target":"x86_64-unknown-linux-gnu","classification":"unknown","conformance":"not-tested"}]},{"id":"gfa.language.matrix.mat-cpy","name":"MAT CPY","kind":"statement","namespace":"language-core","category":"matrix-operations","detail":"api-catalogue-details/gfa.language.matrix.mat-cpy.json","syntax":["MAT CPY destination([i,j])=source([k,l])[,h,w]","MAT CPY destination()=source()","MAT CPY destination(i,j)=source()","MAT CPY destination()=source(k,l)"],"summary":"Copies a rectangular region from a source vector/matrix to a destination field. Optional offsets select source and destination positions; optional h and w select the copied extent. Shorthand forms copy the overlapping elements whose indices exist in both fields.","evidence_status":"book-documented","implementation_status":"not-implemented","support":[{"target":"x86_64-unknown-linux-gnu","classification":"unknown","conformance":"not-tested"}]},{"id":"gfa.language.matrix.mat-det","name":"MAT DET","kind":"statement","namespace":"language-core","category":"matrix-operations","detail":"api-catalogue-details/gfa.language.matrix.mat-det.json","syntax":["MAT DET scalar-result=array([row,column])[,size]"],"summary":"Calculates the determinant of a square matrix or a selected square submatrix beginning at the specified row and column offsets.","evidence_status":"book-documented","implementation_status":"not-implemented","support":[{"target":"x86_64-unknown-linux-gnu","classification":"unknown","conformance":"not-tested"}]},{"id":"gfa.language.matrix.mat-input","name":"MAT INPUT","kind":"statement","namespace":"language-core","category":"matrix-operations","detail":"api-catalogue-details/gfa.language.matrix.mat-input.json","syntax":["MAT INPUT #channel, array()"],"summary":"Reads a vector or matrix from an ASCII file using the reverse of MAT PRINT's format; commas and rowfeeds may vary as with INPUT #.","evidence_status":"book-documented","implementation_status":"not-implemented","support":[{"target":"x86_64-unknown-linux-gnu","classification":"unknown","conformance":"not-tested"}]},{"id":"gfa.language.matrix.mat-inv","name":"MAT INV","kind":"statement","namespace":"language-core","category":"matrix-operations","detail":"api-catalogue-details/gfa.language.matrix.mat-inv.json","syntax":["MAT INV destination()=source()","MAT INV source()=destination()"],"summary":"Calculates the inverse of a square matrix and writes the result to another matrix of the same type and dimensions; the documented operand direction is disputed within the source.","evidence_status":"disputed","implementation_status":"not-implemented","support":[{"target":"x86_64-unknown-linux-gnu","classification":"unknown","conformance":"not-tested"}]},{"id":"gfa.language.matrix.mat-mul","name":"MAT MUL","kind":"statement","namespace":"language-core","category":"matrix-operations","detail":"api-catalogue-details/gfa.language.matrix.mat-mul.json","syntax":["MAT MUL destination()=left()*right()","MAT MUL scalar-result=left()*right()","MAT MUL scalar-result=left()*matrix()*right()","MAT MUL array(),scalar"],"summary":"Multiplies compatible matrices row-by-column, forms an outer product for two vectors, computes a vector dot product or compatible row-vector/matrix/column-vector scalar product, or multiplies every field element by a scalar in place.","evidence_status":"book-documented","implementation_status":"not-implemented","support":[{"target":"x86_64-unknown-linux-gnu","classification":"unknown","conformance":"not-tested"}]},{"id":"gfa.language.matrix.mat-print","name":"MAT PRINT","kind":"statement","namespace":"language-core","category":"matrix-operations","detail":"api-catalogue-details/gfa.language.matrix.mat-print.json","syntax":["MAT PRINT [#channel,] array()[, g, n]"],"summary":"Outputs a vector on one row with comma-separated elements, or a matrix with a rowfeed after each row. Output may be redirected to a channel; optional g and n formatting follows STR$(x,g,n).","evidence_status":"book-documented","implementation_status":"not-implemented","support":[{"target":"x86_64-unknown-linux-gnu","classification":"unknown","conformance":"not-tested"}]},{"id":"gfa.language.matrix.mat-qdet","name":"MAT QDET","kind":"statement","namespace":"language-core","category":"matrix-operations","detail":"api-catalogue-details/gfa.language.matrix.mat-qdet.json","syntax":["MAT QDET scalar-result=array([row,column])[,size]"],"summary":"Calculates a determinant using an operation optimized for speed rather than accuracy; otherwise it works like MAT DET.","evidence_status":"book-documented","implementation_status":"not-implemented","support":[{"target":"x86_64-unknown-linux-gnu","classification":"unknown","conformance":"not-tested"}]},{"id":"gfa.language.matrix.mat-rang","name":"MAT RANG","kind":"statement","namespace":"language-core","category":"matrix-operations","detail":"api-catalogue-details/gfa.language.matrix.mat-rang.json","syntax":["MAT RANG scalar-result=array([row,column])[,size]"],"summary":"Calculates the rank of a square matrix or selected square submatrix; the optional size selects an n-by-n submatrix starting at the row and column offsets.","evidence_status":"book-documented","implementation_status":"not-implemented","support":[{"target":"x86_64-unknown-linux-gnu","classification":"unknown","conformance":"not-tested"}]},{"id":"gfa.language.matrix.mat-read","name":"MAT READ","kind":"statement","namespace":"language-core","category":"matrix-operations","detail":"api-catalogue-details/gfa.language.matrix.mat-read.json","syntax":["MAT READ array()"],"summary":"Reads a previously dimensioned vector or matrix from DATA rows.","evidence_status":"book-documented","implementation_status":"not-implemented","support":[{"target":"x86_64-unknown-linux-gnu","classification":"unknown","conformance":"not-tested"}]},{"id":"gfa.language.matrix.mat-sub","name":"MAT SUB","kind":"statement","namespace":"language-core","category":"matrix-operations","detail":"api-catalogue-details/gfa.language.matrix.mat-sub.json","syntax":["MAT SUB destination()=left()-right()","MAT SUB destination(),source()","MAT SUB destination(),scalar"],"summary":"Subtracts matrices/vectors element by element, or subtracts a scalar from every element. The three-field form writes the result to a destination; the two-argument forms mutate the destination in place. Array operands in the element-wise forms must have the same order.","evidence_status":"book-documented","implementation_status":"not-implemented","support":[{"target":"x86_64-unknown-linux-gnu","classification":"unknown","conformance":"not-tested"}]},{"id":"gfa.language.matrix.mat-xcpy","name":"MAT XCPY","kind":"statement","namespace":"language-core","category":"matrix-operations","detail":"api-catalogue-details/gfa.language.matrix.mat-xcpy.json","syntax":["MAT XCPY destination([i,j])=source([k,l])[,h,w]"],"summary":"Copies a selected source region to the destination while transposing source rows and columns. The source field remains unchanged.","evidence_status":"book-documented","implementation_status":"not-implemented","support":[{"target":"x86_64-unknown-linux-gnu","classification":"unknown","conformance":"not-tested"}]},{"id":"gfa.language.memory.special-longword-variables","name":"_0.._9","kind":"variable","namespace":"language-core","category":"special-variables-and-data-pointers","detail":"api-catalogue-details/gfa.language.memory.special-longword-variables.json","syntax":["_0 through _9"],"summary":"Provides ten special longword variables, not floating-point variables. They are erased by NEW but not by CLEAR, LOAD, CHAIN, or RUN.","evidence_status":"book-documented","implementation_status":"not-implemented","support":[{"target":"x86_64-unknown-linux-gnu","classification":"unknown","conformance":"not-tested"}]},{"id":"gfa.language.data.data-pointer","name":"_DATA","kind":"variable","namespace":"language-core","category":"special-variables-and-data-pointers","detail":"api-catalogue-details/gfa.language.data.data-pointer.json","syntax":["_DATA"],"summary":"Returns the current DATA-pointer position; returns 0 when the next READ would cause an out-of-data condition.","evidence_status":"book-documented","implementation_status":"not-implemented","support":[{"target":"x86_64-unknown-linux-gnu","classification":"unknown","conformance":"not-tested"}]},{"id":"gfa.language.data.set-data-pointer","name":"_DATA=","kind":"statement","namespace":"language-core","category":"special-variables-and-data-pointers","detail":"api-catalogue-details/gfa.language.data.set-data-pointer.json","syntax":["_DATA= integer-expression"],"summary":"Sets the DATA pointer to a value previously obtained with _DATA.","evidence_status":"book-documented","implementation_status":"not-implemented","support":[{"target":"x86_64-unknown-linux-gnu","classification":"unknown","conformance":"not-tested"}]}],"coverage_note":"Evidence, implementation, target support, and conformance are independent dimensions. Unknown, disputed, and not-tested entries remain visible; no aggregate implementation percentage is calculated. Full declaration details are separate static JSON files."}
