        {
          "name": "scalar",
          "type": "numeric scalar expression",
          "required": true
        }
      ]
    }
  ],
  "signature": {
    "type": "no return value"
  },
  "semantics": {
    "summary": "Multiplies compatible matrices row-by-column, forms an outer product for two vectors, computes a vector dot product or compatible row-vector/matrix/column-vector scalar product, or multiplies every field element by a scalar in place.",
    "side-effects": [
      "Matrix/vector destination forms write a result field; scalar form mutates the supplied field."
    ],
    "errors": []
  },
