        {
          "name": "left",
          "type": "floating-point matrix or vector field",
          "required": true,
          "passing": "array"
        },
        {
          "name": "right",
          "type": "floating-point matrix or vector field",
          "required": true,
          "passing": "array"
        }
      ]
    },
    {
      "form": "MAT MUL scalar-result=left()*right()",
      "contexts": [
        "statement"
      ],
      "arguments": [
        {
          "name": "scalar-result",
          "type": "numeric scalar lvalue",
          "required": true,
          "passing": "var"
        },
        {
          "name": "left",
          "type": "floating-point vector",
          "required": true,
          "passing": "array"
        },
        {
          "name": "right",
          "type": "floating-point vector",
          "required": true,
          "passing": "array"
        }
      ]
    },
    {
      "form": "MAT MUL scalar-result=left()*matrix()*right()",
      "contexts": [
        "statement"
      ],
      "arguments": [
        {
          "name": "scalar-result",
          "type": "numeric scalar lvalue",
          "required": true,
          "passing": "var"
        },
        {
          "name": "left",
          "type": "compatible floating-point row vector",
          "required": true,
          "passing": "array"
        },
        {
          "name": "matrix",
          "type": "compatible floating-point matrix",
          "required": true,
          "passing": "array"
        },
        {
          "name": "right",
          "type": "compatible floating-point column vector",
          "required": true,
          "passing": "array"
        }
      ]
    },
    {
      "form": "MAT MUL array(),scalar",
      "contexts": [
        "statement"
      ],
      "arguments": [
        {
          "name": "array",
          "type": "floating-point matrix or vector field",
          "required": true,
          "passing": "array"
