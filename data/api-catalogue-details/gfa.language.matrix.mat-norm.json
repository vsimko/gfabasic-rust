      "form": "MAT NORM array(), 0 | 1",
      "contexts": [
        "statement"
      ],
      "arguments": [
        {
          "name": "array",
          "type": "previously dimensioned one- or two-dimensional floating-point field",
          "required": true,
          "passing": "array"
        },
        {
          "name": "mode",
          "type": "integer literal 0 (rows) or 1 (columns)",
          "required": true
        }
      ]
    }
  ],
  "signature": {
    "type": "no return value"
  },
  "semantics": {
    "summary": "Normalizes each row when mode is 0, or each column when mode is 1, so the sum of squares of the elements in each normalized vector is 1.",
    "side-effects": [
      "Scales matrix elements in place."
    ],
