{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GFA BASIC API registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema-version", "declarations"],
  "properties": {
    "schema-version": {"const": 1},
    "declarations": {"type": "array", "items": {"$ref": "#/$defs/declaration"}}
  },
  "$defs": {
    "stringArray": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "argument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "repeated": {"type": "boolean"},
        "passing": {"enum": ["value", "reference", "var", "array", "pointer"]},
        "marker": {"type": "string"}
      }
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "availability", "syntax", "signature", "semantics", "evidence", "implementation", "support", "docs"],
      "properties": {
        "id": {"type": "string", "pattern": "^gfa\\.(language|amiga|atari-st)\\.[a-z0-9-]+(\\.[a-z0-9-]+)*$"},
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["statement", "function", "procedure", "operator", "special-form", "constant", "variable", "structure"]},
        "overload-group": {"type": "string", "minLength": 1},
        "availability": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dialect", "versions"],
            "properties": {
              "dialect": {"type": "string", "minLength": 1},
              "versions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "profile": {"enum": ["amiga", "atari-st"]}
            }
          }
        },
        "syntax": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["form", "contexts"],
            "properties": {
              "form": {"type": "string", "minLength": 1},
              "contexts": {"type": "array", "minItems": 1, "items": {"enum": ["statement", "expression", "declaration", "lvalue"]}},
              "arguments": {"type": "array", "items": {"$ref": "#/$defs/argument"}}
            }
          }
        },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "returns": {"type": "string", "minLength": 1},
            "type": {"type": "string", "minLength": 1},
            "parameters": {"type": "array", "items": {"$ref": "#/$defs/argument"}}
          },
          "anyOf": [{"required": ["returns"]}, {"required": ["type"]}]
        },
        "semantics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary"],
          "properties": {
            "summary": {"type": "string", "minLength": 1},
            "side-effects": {"$ref": "#/$defs/stringArray"},
            "errors": {"$ref": "#/$defs/stringArray"},
            "resource-lifecycle": {"type": "string"}
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "sources"],
          "properties": {
            "status": {"enum": ["unknown", "inferred", "disputed", "book-documented", "primary-reference-cross-checked", "runtime-observed"]},
            "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "printed-pages": {"$ref": "#/$defs/stringArray"},
            "notes": {"$ref": "#/$defs/stringArray"}
          }
        },
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {"enum": ["not-implemented", "partial", "implemented", "unsafe-disabled"]},
            "handler": {"type": "string", "minLength": 1}
          }
        },
        "support": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "classification", "conformance", "tests"],
            "properties": {
              "target": {"type": "string", "minLength": 1},
              "classification": {"enum": ["supported", "partial", "adapter-backed", "emulated", "unsupported", "unsafe-disabled", "unknown"]},
              "conformance": {"enum": ["not-tested", "passing", "failing", "not-applicable"]},
              "tests": {"$ref": "#/$defs/stringArray"},
              "pending-reason": {"type": "string"}
            }
          }
        },
        "docs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "anchors"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "anchors": {"$ref": "#/$defs/stringArray"}
          }
        }
      }
    }
  }
}
