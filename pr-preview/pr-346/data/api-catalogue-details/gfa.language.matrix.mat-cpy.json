          "required": false
        },
        {
          "name": "h",
          "type": "optional integer-expression copy height",
          "required": false
        },
        {
          "name": "w",
          "type": "optional integer-expression copy width",
          "required": false
        }
      ]
    },
    {
      "form": "MAT CPY destination()=source()",
      "contexts": [
        "statement"
