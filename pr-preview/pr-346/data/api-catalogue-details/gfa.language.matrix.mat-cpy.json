  "signature": {
    "type": "no return value"
  },
  "semantics": {
    "summary": "Copies a rectangular region from a source vector/matrix to a destination field. Optional offsets select source and destination positions; optional h and w select the copied extent. Shorthand forms copy the overlapping elements whose indices exist in both fields.",
    "side-effects": [
      "Writes the selected destination elements; existing destination values in the copied region are replaced."
    ],
    "errors": []
  },
  "evidence": {
    "source-scope": "amiga-3.5-addendum",
    "status": "book-documented",
    "sources": [
      "AM-INTERPRETER-35"
    ],
    "printed-pages": [
      "Chapter 13, printed pp. 13-4–13-19"
    ],
    "notes": [
      "The page-image-reviewed material documents region offsets, extents, overlapping-index shorthand, and vector-specific forms.",
      "For vector operands, MAT CPY treats both vectors syntactically as column vectors; the documented syntax uses dimensions (n,1).",
      "For MAT CPY optional vector extents, w>=1 makes only h relevant and w=0 performs no copy."
    ]
  },
