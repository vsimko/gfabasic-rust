REM GFA BASIC 3.52 native interpreter regression batch.
REM Loaded as ASCII through the native Editor Merge (F2) command.
REM This is a 3.52 runtime probe, not normative 3.5 conformance evidence.

OPEN "Output",#1,"DF0:FACT.OUT"
OPEN "Output",#2,"DF0:GFATEST.OUT"

REM FACT boundary values.
x = FACT(0)
y = FACT(1)
z = FACT(2)
PRINT #1,"FACT(0..2):";x;y;z
IF x=1 AND y=1 AND z=2
  PRINT #2,"GFATEST:fact-zero:PASS"
ELSE
  PRINT #2,"GFATEST:fact-zero:FAIL"
ENDIF

REM Integer arithmetic and operator precedence.
a = 2 + 3 * 4
b = (2 + 3) * 4
PRINT #1,"ARITHMETIC:";a;b
IF a=14 AND b=20
  PRINT #2,"GFATEST:arithmetic:PASS"
ELSE
  PRINT #2,"GFATEST:arithmetic:FAIL"
ENDIF

REM FOR/NEXT loop.
sum = 0
FOR i = 1 TO 4
  sum = sum + i
NEXT i
PRINT #1,"FOR-NEXT:";sum
IF sum=10
  PRINT #2,"GFATEST:for-next:PASS"
ELSE
  PRINT #2,"GFATEST:for-next:FAIL"
ENDIF

REM String concatenation and LEFT$.
s$ = "GFA" + " BASIC"
t$ = LEFT$(s$,3)
PRINT #1,"STRINGS:";t$;s$
IF t$="GFA" AND s$="GFA BASIC"
  PRINT #2,"GFATEST:strings:PASS"
ELSE
  PRINT #2,"GFATEST:strings:FAIL"
ENDIF

REM Editor shortcut probe: M O is documented as MAT ONE in GFA BASIC 3.52.
PRINT #1,"BEFORE-MAT-ONE"
DIM identity(3,3)
M O identity()
PRINT #1,"AFTER-MAT-ONE"
MAT PRINT #1,identity()
IF identity(1,1)=1 AND identity(1,2)=0 AND identity(1,3)=0 AND identity(2,1)=0 AND identity(2,2)=1 AND identity(2,3)=0 AND identity(3,1)=0 AND identity(3,2)=0 AND identity(3,3)=1
  PRINT #2,"GFATEST:matrix-one:PASS"
ELSE
  PRINT #2,"GFATEST:matrix-one:FAIL"
ENDIF


REM Function checks: INT, SQR, SUCC, STRING$, and HEX$.
v = INT(3.7)
IF v=3
  PRINT #2,"GFATEST:int:PASS"
ELSE
  PRINT #2,"GFATEST:int:FAIL"
ENDIF
v = SQR(9)
IF v=3
  PRINT #2,"GFATEST:sqr:PASS"
ELSE
  PRINT #2,"GFATEST:sqr:FAIL"
ENDIF
v = SUCC(1)
IF v=2
  PRINT #2,"GFATEST:succ:PASS"
ELSE
  PRINT #2,"GFATEST:succ:FAIL"
ENDIF
s$ = STRING$(3,"-")
IF s$="---"
  PRINT #2,"GFATEST:string-repeat:PASS"
ELSE
  PRINT #2,"GFATEST:string-repeat:FAIL"
ENDIF
s$ = HEX$(255)
IF s$="FF"
  PRINT #2,"GFATEST:hex:PASS"
ELSE
  PRINT #2,"GFATEST:hex:FAIL"
ENDIF

REM One-line expression function: exact DEFFN/FN form found in a
REM historical application listing; this probe checks 3.52 execution only.
DEFFN gfa562=ASC("A")
value = FN gfa562
PRINT #1,"DEFFN-FN:";value
IF value=65
  PRINT #2,"GFATEST:deffn-fn:PASS"
ELSE
  PRINT #2,"GFATEST:deffn-fn:FAIL"
ENDIF

REM UPPER$ converts lowercase letters to uppercase.
s$ = UPPER$("Gfa-Basic 3.52")
PRINT #1,"UPPER$:";s$
IF s$="GFA-BASIC 3.52"
  PRINT #2,"GFATEST:upper-dollar:PASS"
ELSE
  PRINT #2,"GFATEST:upper-dollar:FAIL"
ENDIF

CLOSE #2
CLOSE #1
