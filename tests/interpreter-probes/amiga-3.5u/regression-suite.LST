REM GFA BASIC 3.5U MAT ONE regression probe / issue #537.
REM Use the documented full command spelling; avoid abbreviation expansion.
REM The manual (printed p. 13-2) defines MAT ONE as a square identity matrix.
OPEN "O",#1,"DF0:FACT.OUT"
PRINT #1,"BEFORE-MAT-ONE"
DIM a(3,3)
MAT ONE a()
PRINT #1,"AFTER-MAT-ONE"
PRINT #1,a(1,1),a(1,2),a(1,3)
PRINT #1,a(2,1),a(2,2),a(2,3)
PRINT #1,a(3,1),a(3,2),a(3,3)
CLOSE #1
