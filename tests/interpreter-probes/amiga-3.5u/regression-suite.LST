REM Minimal GFA BASIC 3.5U MAT ONE probe for issue #537.
REM Output marker BEFORE-MAT-ONE distinguishes setup failure from MAT ONE failure.
REM Manual reference: GFA-BASIC 3.5 Interpreter, addendum p. 13-2.
DIM a(3,3)
OPEN "O",#1,"DF0:FACT.OUT"
OPEN "O",#2,"DF0:GFATEST.OUT"
PRINT #1,"BEFORE-MAT-ONE"
MAT ONE a()
PRINT #1,"MAT-ONE:";a(1,1);a(1,2);a(1,3);a(2,1);a(2,2);a(2,3);a(3,1);a(3,2);a(3,3)
IF a(1,1)=1 AND a(1,2)=0 AND a(1,3)=0 AND a(2,1)=0 AND a(2,2)=1 AND a(2,3)=0 AND a(3,1)=0 AND a(3,2)=0 AND a(3,3)=1
  PRINT #2,"GFATEST:matrix-one:PASS"
ELSE
  PRINT #2,"GFATEST:matrix-one:FAIL"
ENDIF
CLOSE #2
CLOSE #1
END
