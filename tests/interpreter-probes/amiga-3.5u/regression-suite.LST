REM Isolated MAT ONE probe for issue #537.
REM Matches the GFA BASIC 3.5 Interpreter addendum example (p. 13-2).
REM No MAT SET or MAT BASE: the documented example needs only DIM and MAT ONE.
OPEN "O",#1,"DF0:BEFORE.OUT"
PRINT #1,"BEFORE-MAT-ONE"
CLOSE #1

DIM a(3,3)
MAT ONE a()

OPEN "O",#2,"DF0:FACT.OUT"
PRINT #2,"AFTER-MAT-ONE"
PRINT #2,"DIAGONAL:";a(1,1);a(2,2);a(3,3)
PRINT #2,"OFF-DIAGONAL:";a(1,2);a(1,3);a(2,1);a(2,3);a(3,1);a(3,2)
CLOSE #2

OPEN "O",#3,"DF0:GFATEST.OUT"
IF a(1,1)=1 AND a(2,2)=1 AND a(3,3)=1 AND a(1,2)=0 AND a(1,3)=0 AND a(2,1)=0 AND a(2,3)=0 AND a(3,1)=0 AND a(3,2)=0
  PRINT #3,"GFATEST:matrix-one:PASS"
ELSE
  PRINT #3,"GFATEST:matrix-one:FAIL"
ENDIF
CLOSE #3
END
