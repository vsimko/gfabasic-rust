REM GFA BASIC 3.5U native interpreter regression batch.
REM Loaded as ASCII through the native Editor Merge (F2) command.
REM This is a 3.5U runtime probe, not normative 3.5 conformance evidence.
REM IMPORTANT: OPEN file mode is uppercase letter "O" (Output), NOT digit "0".

REM 3.5 addendum pp. 13-34..13-35: save and restore DATA pointers.
DIM dp%(100)
REM Capture runtime output on the writable DF0 test disk.
OPEN "O",#1,"DF0:FACT.OUT"
OPEN "O",#2,"DF0:GFATEST.OUT"

REM 3.5 addendum pp. 13-34..13-35: save and restore DATA pointers.
RESTORE
PRINT #1,"DATA-AVAILABLE-INITIAL:";_DATA
i%=0
DO WHILE _DATA
  dp%(i%)=_DATA
  INC i%
  READ a
LOOP
DEC i%

sum%=0
FOR j%=i% DOWNTO 0
  _DATA=dp%(j%)
  READ a
  PRINT #1,"DATA-VALUE:";a
  sum%=sum%+a
NEXT j%
PRINT #1,"DATA-POINTER:";i%;sum%
IF i%=14 AND sum%=3653
  PRINT #2,"GFATEST:data-pointer:PASS"
ELSE
  PRINT #2,"GFATEST:data-pointer:FAIL"
ENDIF

REM FACT boundary values.
x = FACT(0)
y = FACT(1)
z = FACT(2)
PRINT #1,"FACT(0..2):";x;y;z
IF x=1 AND y=1 AND z=2
  PRINT #2,"GFATEST:fact-zero:PASS"
ELSE
  PRINT #2,"GFATEST:fact-zero:FAIL"
ENDIF

REM Integer arithmetic and operator precedence.
a = 2 + 3 * 4
b = (2 + 3) * 4
PRINT #1,"ARITHMETIC:";a;b
IF a=14 AND b=20
  PRINT #2,"GFATEST:arithmetic:PASS"
ELSE
  PRINT #2,"GFATEST:arithmetic:FAIL"
ENDIF

REM FOR/NEXT loop.
sum = 0
FOR i = 1 TO 4
  sum = sum + i
NEXT i
PRINT #1,"FOR-NEXT:";sum
IF sum=10
  PRINT #2,"GFATEST:for-next:PASS"
ELSE
  PRINT #2,"GFATEST:for-next:FAIL"
ENDIF

REM String concatenation and LEFT$.
s$ = "GFA" + " BASIC"
t$ = LEFT$(s$,3)
PRINT #1,"STRINGS:";t$;s$
IF t$="GFA" AND s$="GFA BASIC"
  PRINT #2,"GFATEST:strings:PASS"
ELSE
  PRINT #2,"GFATEST:strings:FAIL"
ENDIF


REM 3.5 addendum pp. 13-26..13-27: determinant of a square matrix.
DIM detm(2,2)
detm(1,1)=1
detm(1,2)=2
detm(2,1)=3
detm(2,2)=4
MAT DET detvalue=detm()
PRINT #1,"MAT-DET:";detvalue
IF detvalue=-2
  PRINT #2,"GFATEST:matrix-det:PASS"
ELSE
  PRINT #2,"GFATEST:matrix-det:FAIL"
ENDIF

CLOSE #2
CLOSE #1
END

DATA 1,2,3,4,5,6,7,8,9
DATA 13,24,328,3242,1,0
