REM GFA BASIC 3.5U native interpreter regression batch.
REM Loaded as ASCII through the native Editor Merge (F2) command.
REM This is a 3.5U runtime probe, not normative 3.5 conformance evidence.
REM IMPORTANT: OPEN file mode is uppercase letter "O" (Output), NOT digit "0".

REM 3.5 addendum pp. 13-34..13-35: save and restore DATA pointers.
DIM dp%(100),detm(2,2),invsrc(2,2),invm(2,2),invcheck(2,2)
DIM unity(2,2),addleft(2,2),addright(2,2),addresult(2,2),subresult(2,2)
REM Capture runtime output on the writable DF0 test disk.
OPEN "O",#1,"DF0:FACT.OUT"
OPEN "O",#2,"DF0:GFATEST.OUT"

REM 3.5 addendum pp. 13-34..13-35: save and restore DATA pointers.
RESTORE
PRINT #1,"DATA-AVAILABLE-INITIAL:";_DATA
i%=0
DO WHILE _DATA
  dp%(i%)=_DATA
  INC i%
  READ a
LOOP
DEC i%

sum%=0
FOR j%=i% DOWNTO 0
  _DATA=dp%(j%)
  READ a
  PRINT #1,"DATA-VALUE:";a
  sum%=sum%+a
NEXT j%
PRINT #1,"DATA-POINTER:";i%;sum%
IF i%=14 AND sum%=3653
  PRINT #2,"GFATEST:data-pointer:PASS"
ELSE
  PRINT #2,"GFATEST:data-pointer:FAIL"
ENDIF

REM FACT boundary values.
x = FACT(0)
y = FACT(1)
z = FACT(2)
PRINT #1,"FACT(0..2):";x;y;z
IF x=1 AND y=1 AND z=2
  PRINT #2,"GFATEST:fact-zero:PASS"
ELSE
  PRINT #2,"GFATEST:fact-zero:FAIL"
ENDIF

REM Integer arithmetic and operator precedence.
a = 2 + 3 * 4
b = (2 + 3) * 4
PRINT #1,"ARITHMETIC:";a;b
IF a=14 AND b=20
  PRINT #2,"GFATEST:arithmetic:PASS"
ELSE
  PRINT #2,"GFATEST:arithmetic:FAIL"
ENDIF

REM FOR/NEXT loop.
sum = 0
FOR i = 1 TO 4
  sum = sum + i
NEXT i
PRINT #1,"FOR-NEXT:";sum
IF sum=10
  PRINT #2,"GFATEST:for-next:PASS"
ELSE
  PRINT #2,"GFATEST:for-next:FAIL"
ENDIF

REM String concatenation and LEFT$.
s$ = "GFA" + " BASIC"
t$ = LEFT$(s$,3)
PRINT #1,"STRINGS:";t$;s$
IF t$="GFA" AND s$="GFA BASIC"
  PRINT #2,"GFATEST:strings:PASS"
ELSE
  PRINT #2,"GFATEST:strings:FAIL"
ENDIF

REM 3.5 addendum pp. 13-26..13-27: determinant of a square matrix.
detm(1,1)=1
detm(1,2)=2
detm(2,1)=3
detm(2,2)=4
MAT DET detvalue=detm()
PRINT #1,"MAT-DET:";detvalue
IF detvalue=-2
  PRINT #2,"GFATEST:matrix-det:PASS"
ELSE
  PRINT #2,"GFATEST:matrix-det:FAIL"
ENDIF

REM 3.5 addendum p. 13-30: invert a square matrix into a same-type matrix.
REM The inverse of [[1,2],[3,4]] is [[-2,1],[1.5,-0.5]].
invsrc(1,1)=1
invsrc(1,2)=2
invsrc(2,1)=3
invsrc(2,2)=4
MAT INV invm()=invsrc()
MAT MUL invcheck()=invm()*invsrc()
PRINT #1,"MAT-INV:";invm(1,1);invm(1,2);invm(2,1);invm(2,2)
PRINT #1,"MAT-INV-PRODUCT:";invcheck(1,1);invcheck(1,2);invcheck(2,1);invcheck(2,2)
IF invcheck(1,1)>0.99 AND invcheck(1,1)<1.01 AND invcheck(1,2)>-0.01 AND invcheck(1,2)<0.01 AND invcheck(2,1)>-0.01 AND invcheck(2,1)<0.01 AND invcheck(2,2)>0.99 AND invcheck(2,2)<1.01
  PRINT #2,"GFATEST:matrix-inv:PASS"
ELSE
  PRINT #2,"GFATEST:matrix-inv:FAIL"
ENDIF

REM 3.5 addendum p. 13-2: MAT ONE creates a square identity matrix.
MAT ONE unity()
IF unity(1,1)=1 AND unity(1,2)=0 AND unity(2,1)=0 AND unity(2,2)=1
  PRINT #2,"GFATEST:matrix-one:PASS"
ELSE
  PRINT #2,"GFATEST:matrix-one:FAIL"
ENDIF

END

REM 3.5 addendum pp. 13-16..13-19: element-wise matrix addition and subtraction.
addleft(1,1)=1
addleft(1,2)=2
addleft(2,1)=3
addleft(2,2)=4
addright(1,1)=5
addright(1,2)=6
addright(2,1)=7
addright(2,2)=8
MAT ADD addresult()=addleft()+addright()
MAT SUB subresult()=addleft()-addright()
PRINT #1,"MAT-ADD:";addresult(1,1);addresult(1,2);addresult(2,1);addresult(2,2)
PRINT #1,"MAT-SUB:";subresult(1,1);subresult(1,2);subresult(2,1);subresult(2,2)
IF addresult(1,1)=6 AND addresult(1,2)=8 AND addresult(2,1)=10 AND addresult(2,2)=12
  PRINT #2,"GFATEST:matrix-add:PASS"
ELSE
  PRINT #2,"GFATEST:matrix-add:FAIL"
ENDIF
IF subresult(1,1)=-4 AND subresult(1,2)=-4 AND subresult(2,1)=-4 AND subresult(2,2)=-4
  PRINT #2,"GFATEST:matrix-sub:PASS"
ELSE
  PRINT #2,"GFATEST:matrix-sub:FAIL"
ENDIF

CLOSE #2
CLOSE #1
END

DATA 1,2,3,4,5,6,7,8,9
DATA 13,24,328,3242,1,0
