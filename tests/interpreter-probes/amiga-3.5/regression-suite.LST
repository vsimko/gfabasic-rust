REM Amiga GFA-BASIC 3.5 native interpreter probe.
REM Loaded through the native Editor Merge (F2) command.
REM Results are observations for the exact 3.5 interpreter identity captured by CI.

OPEN "O",#1,"DF0:GFATEST.OUT"

REM Arithmetic precedence and grouping.
a = 2 + 3 * 4
b = (2 + 3) * 4
IF a=14 AND b=20
  PRINT #1,"GFATEST:arithmetic:PASS"
ELSE
  PRINT #1,"GFATEST:arithmetic:FAIL"
ENDIF

REM FOR/NEXT loop.
sum = 0
FOR i = 1 TO 4
  sum = sum + i
NEXT i
IF sum=10
  PRINT #1,"GFATEST:for-next:PASS"
ELSE
  PRINT #1,"GFATEST:for-next:FAIL"
ENDIF

REM String concatenation and LEFT$.
s$ = "GFA" + " BASIC"
t$ = LEFT$(s$,3)
IF t$="GFA" AND s$="GFA BASIC"
  PRINT #1,"GFATEST:strings:PASS"
ELSE
  PRINT #1,"GFATEST:strings:FAIL"
ENDIF

CLOSE #1
