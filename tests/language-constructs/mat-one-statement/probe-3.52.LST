OPEN "Output",#1,"DF0:GFATEST.OUT"
DIM identity(3,3)
M O identity()
IF identity(1,1)=1 AND identity(1,2)=0 AND identity(1,3)=0 AND identity(2,1)=0 AND identity(2,2)=1 AND identity(2,3)=0 AND identity(3,1)=0 AND identity(3,2)=0 AND identity(3,3)=1
  PRINT #1,"GFATEST:matrix-one:PASS"
ELSE
  PRINT #1,"GFATEST:matrix-one:FAIL"
ENDIF
CLOSE #1
