{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vsimko/gfabasic-rust/blob/main/tests/language-constructs/manifest.schema.json",
  "title": "GFA-BASIC language construct manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_schema_version", "construct", "evidence", "versions"],
  "properties": {
    "manifest_schema_version": {"const": 1},
    "construct": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "name", "summary", "syntax_forms"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "kind": {"enum": ["statement", "function", "operator", "declaration", "special-form", "command"]},
        "name": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "syntax_forms": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["text", "versions"],
          "properties": {
            "text": {"type": "string", "minLength": 1},
            "versions": {"type": "array", "minItems": 1, "uniqueItems": true,
              "items": {"enum": ["3.041U", "3.5", "3.52"]}}
          }
        }}
      }
    },
    "evidence": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source_id", "location", "kind", "status", "claim"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "source_id": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1},
        "kind": {"enum": ["primary-manual", "repository-adr", "native-observation", "repository-code", "secondary-reference"]},
        "status": {"enum": ["page-image-verified", "text-verified", "direct-observation", "repository-record", "secondary", "unknown", "disputed"]},
        "claim": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"}
      }
    }},
    "versions": {
      "type": "object", "additionalProperties": false,
      "required": ["3.041U", "3.5", "3.52"],
      "properties": {
        "3.041U": {"$ref": "#/$defs/version"},
        "3.5": {"$ref": "#/$defs/version"},
        "3.52": {"$ref": "#/$defs/version"}
      }
    }
  },
  "$defs": {
    "refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "version": {
      "type": "object", "additionalProperties": false,
      "required": ["applicability", "expectation", "probe", "execution", "implementation"],
      "properties": {
        "applicability": {"enum": ["applicable", "not-applicable", "unknown"]},
        "expectation": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "summary", "evidence_refs"],
          "properties": {
            "status": {"enum": ["documented", "observed", "unknown", "not-applicable"]},
            "summary": {"type": "string", "minLength": 1},
            "evidence_refs": {"$ref": "#/$defs/refs"}
          }
        },
        "probe": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.LST$"},
        "execution": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "observed", "run_url", "probe_source", "evidence_refs"],
          "properties": {
            "status": {"enum": ["PASS", "FAIL", "DIFFERENT", "UNTESTED"]},
            "observed": {"type": ["string", "null"]},
            "run_url": {"type": ["string", "null"], "format": "uri"},
            "probe_source": {"type": ["string", "null"]},
            "evidence_refs": {"$ref": "#/$defs/refs"}
          }
        },
        "implementation": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "refs"],
          "properties": {
            "status": {"enum": ["not-targeted", "not-started", "syntax-only", "prototype", "production", "unknown"]},
            "refs": {"$ref": "#/$defs/refs"}
          }
        }
      }
    }
  }
}
